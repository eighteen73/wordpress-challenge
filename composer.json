{
	"name": "eighteen73/challenge",
	"description": "Opinionated CAPTCHA protection for WordPress",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"eighteen73/wordpress-coding-standards": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Eighteen73\\Challenge\\": "includes/classes/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "./vendor/bin/phpcs",
		"format": "./vendor/bin/phpcbf"
	}
}
